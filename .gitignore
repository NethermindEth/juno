.DS_Store
.idea/
.vscode/
.dist
build/
coverage/*
config/
.envrc
.tool-versions
# Default path for Juno DB files.  It will get created if you follow the
# README and/or run `./build/juno` command.
/juno/
p2p-dbs

# Files created when debugging Juno.  It will get created if you use the vscode debugger
*.log
*.sst
MANIFEST-*
OPTIONS-*
CURRENT
LOCK

# RPC benchmark harness: generated corpora and run results (keep the dir).
bench/rpc/corpus/*
!bench/rpc/corpus/.gitkeep
bench/rpc/results/

